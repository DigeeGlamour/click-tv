  "event_lifecycle": {
    "_note": "The Today/Upcoming lifecycle timings, in one place. Read through scanner/lifecycle_config.py, which is the only module that knows the fallbacks. Every value here is minutes unless its name says otherwise.",
    "_target_retry_note": "The retry ladder, as implemented. The trigger fires every five minutes and a fixture inside the window is attempted at most once per five-minute bucket, from move_to_today_minutes before kickoff until target_retry_until_min after it. How many attempts that comes to is a consequence of how many ticks actually arrived, not a promise: a missed tick shortens the ladder and does not break it. The note this replaces promised a fixed count of attempts before the whistle, which was a guarantee the code never made - and at the time the code tried once and stopped. A usable verified stream ends the ladder (resolved: true); a resolved fixture whose published link later dies is reopened by the refresh path and takes its turn under the same bucket rule.",
    "move_to_today_minutes": 25,
    "target_retry_interval_min": 5,
    "target_retry_until_min": 10,
    "post_match_grace_minutes": 20,
    "no_link_today_grace_minutes": 25,
    "confirmations_required": 3,
    "estimate_grace_minutes": 90,
    "unscheduled_carry_hours": 3,
    "unscheduled_carry_confirmations": 36
  }
