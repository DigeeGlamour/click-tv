{
  "selection_mode": "domain_fixed",
  "default_profile": "android_tv",
  "allow_random_fallback": false,
  "preserve_source_headers": true,
  "source_header_priority": [
    "Cookie",
    "Authorization",
    "Referer",
    "Origin",
    "User-Agent"
  ],
  "profiles": {
    "android_tv": {
      "User-Agent": "Mozilla/5.0 (Linux; Android 10; BRAVIA 4K UR3 Build/QTG3.200305.006.S36) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.6261.105 Mobile Safari/537.36",
      "Accept": "*/*",
      "Accept-Language": "en-US,en;q=0.9",
      "Sec-Fetch-Dest": "empty",
      "Sec-Fetch-Mode": "cors",
      "Sec-Fetch-Site": "cross-site",
      "Cache-Control": "no-cache"
    },
    "iphone_safari": {
      "User-Agent": "Mozilla/5.0 (iPhone; CPU iPhone OS 17_4_1 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.3.1 Mobile/15E148 Safari/604.1",
      "Accept": "*/*",
      "Accept-Language": "en-US,en;q=0.9",
      "Sec-Fetch-Dest": "empty",
      "Sec-Fetch-Mode": "cors",
      "Sec-Fetch-Site": "cross-site",
      "Cache-Control": "no-cache"
    },
    "android_chrome": {
      "User-Agent": "Mozilla/5.0 (Linux; Android 14; SM-S928B) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.6367.82 Mobile Safari/537.36",
      "Accept": "*/*",
      "Accept-Language": "en-US,en;q=0.9",
      "Sec-Fetch-Dest": "empty",
      "Sec-Fetch-Mode": "cors",
      "Sec-Fetch-Site": "cross-site",
      "Cache-Control": "no-cache"
    },
    "windows_edge": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36 Edg/124.0.0.0",
      "Accept": "*/*",
      "Accept-Language": "en-US,en;q=0.9",
      "Sec-Fetch-Dest": "empty",
      "Sec-Fetch-Mode": "cors",
      "Sec-Fetch-Site": "cross-site",
      "Cache-Control": "no-cache"
    },
    "macos_safari": {
      "User-Agent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 14_4_1) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.4.1 Safari/605.1.15",
      "Accept": "*/*",
      "Accept-Language": "en-US,en;q=0.9",
      "Sec-Fetch-Dest": "empty",
      "Sec-Fetch-Mode": "cors",
      "Sec-Fetch-Site": "cross-site",
      "Cache-Control": "no-cache"
    },
    "toffee_okhttp": {
      "User-Agent": "okhttp/4.12.0",
      "Accept": "*/*",
      "Cache-Control": "no-cache"
    },
    "streame_center": {
      "User-Agent": "Mozilla/5.0 (Linux; Android 14; SM-S928B) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.6367.82 Mobile Safari/537.36",
      "Referer": "https://streame.center/",
      "Origin": "https://streame.center",
      "Accept": "*/*",
      "Cache-Control": "no-cache"
    },
    "fibwatch": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
      "Referer": "https://fibwatch.art/",
      "Origin": "https://fibwatch.art",
      "Accept": "*/*",
      "Cache-Control": "no-cache"
    },
    "crichd": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
      "Referer": "https://executeandship.com/",
      "Origin": "https://executeandship.com",
      "Accept": "*/*",
      "Cache-Control": "no-cache"
    }
  },
  "domain_rules": [
    {
      "patterns": [
        "toffeelive.com",
        "bldcmprod-cdn.toffeelive.com"
      ],
      "profile": "toffee_okhttp"
    },
    {
      "patterns": [
        "streame.center"
      ],
      "profile": "streame_center"
    },
    {
      "patterns": [
        "fibwatch.art",
        "*.fibwatch.art"
      ],
      "profile": "fibwatch"
    },
    {
      "patterns": [
        "executeandship.com",
        "*.executeandship.com"
      ],
      "profile": "crichd"
    },
    {
      "patterns": [
        "fancode.com",
        "pdlive.fancode.com"
      ],
      "profile": "android_chrome"
    },
    {
      "patterns": [
        "gpcdn.net",
        "jagobd.com.bd",
        "aynaott.com",
        "aynascope.net"
      ],
      "profile": "android_tv"
    },
    {
      "patterns": [
        "aiv-cdn.net",
        "*.aiv-cdn.net"
      ],
      "profile": "android_chrome"
    },
    {
      "patterns": [
        "akamaized.net",
        "*.akamaized.net"
      ],
      "profile": "android_tv"
    },
    {
      "patterns": [
        "cloudfront.net",
        "*.cloudfront.net"
      ],
      "profile": "android_chrome"
    }
  ]
}
