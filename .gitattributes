* text=auto

# GitHub Actions/Linux executables must never receive Windows CRLF endings.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf

# Windows launchers remain native Windows text files.
*.cmd text eol=crlf
*.bat text eol=crlf
